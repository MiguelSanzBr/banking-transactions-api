meta {
  name: Deposit 500.00 into A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accounts/{{accountA}}/deposits
  body: json
  auth: none
}

headers {
  Idempotency-Key: dep-{{run}}
}

body:json {
  {
    "amount": 500.00
  }
}

assert {
  res.status: eq 201
  res.body.amount: eq 500
}

script:post-response {
  bru.setEnvVar("depositId", res.body.id);
}

tests {
  test("credited account A", function () {
    expect(res.body.accountId).to.equal(bru.getEnvVar("accountA"));
  });

  test("is not a replay", function () {
    expect(res.getHeader("idempotent-replayed")).to.be.undefined;
  });
}
