meta {
  name: Create account B (masked CPF)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

body:json {
  {
    "holderName": "Bruno Lima",
    "document": "{{docBMasked}}"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq ACTIVE
}

script:post-response {
  bru.setEnvVar("accountB", res.body.id);
}

tests {
  test("the mask is stripped", function () {
    expect(res.body.document).to.equal(bru.getEnvVar("docB"));
  });
}
