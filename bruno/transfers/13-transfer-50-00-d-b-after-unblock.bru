meta {
  name: Transfer 50.00 D -> B after unblock
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

headers {
  Idempotency-Key: stu901-{{run}}
}

body:json {
  {
    "sourceAccountId": "{{accountD}}",
    "destinationAccountId": "{{accountB}}",
    "amount": 50.00
  }
}

assert {
  res.status: eq 201
  res.body.status: eq COMPLETED
}
