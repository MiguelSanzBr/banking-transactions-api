meta {
  name: Transfer 250.00 A -> B
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

headers {
  Idempotency-Key: abc123-{{run}}
}

body:json {
  {
    "sourceAccountId": "{{accountA}}",
    "destinationAccountId": "{{accountB}}",
    "amount": 250.00
  }
}

assert {
  res.status: eq 201
  res.body.status: eq COMPLETED
  res.body.amount: eq 250
  res.body.failureCode: isNull
}

script:post-response {
  bru.setEnvVar("transferId", res.body.id);
}

tests {
  test("Location points to the transfer", function () {
    expect(res.getHeader("location")).to.equal("/transfers/" + res.body.id);
  });

  test("is not a replay", function () {
    expect(res.getHeader("idempotent-replayed")).to.be.undefined;
  });
}
