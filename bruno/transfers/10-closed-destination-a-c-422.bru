meta {
  name: Closed destination A -> C -> 422
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

headers {
  Idempotency-Key: mno345-{{run}}
}

body:json {
  {
    "sourceAccountId": "{{accountA}}",
    "destinationAccountId": "{{accountC}}",
    "amount": 10.00
  }
}

assert {
  res.status: eq 422
  res.body.code: eq DESTINATION_ACCOUNT_CLOSED
  res.body.correlationId: isString
}
