meta {
  name: Same account A -> A -> 422
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

headers {
  Idempotency-Key: pqr678-{{run}}
}

body:json {
  {
    "sourceAccountId": "{{accountA}}",
    "destinationAccountId": "{{accountA}}",
    "amount": 10.00
  }
}

assert {
  res.status: eq 422
  res.body.code: eq SAME_ACCOUNT
  res.body.correlationId: isString
}
