meta {
  name: Blocked destination A -> D receives -> 201
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

headers {
  Idempotency-Key: jkl012-{{run}}
}

body:json {
  {
    "sourceAccountId": "{{accountA}}",
    "destinationAccountId": "{{accountD}}",
    "amount": 10.00
  }
}

assert {
  res.status: eq 201
  res.body.status: eq COMPLETED
}
