meta {
  name: Deposit negative amount -> 422
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/accounts/{{accountA}}/deposits
  body: json
  auth: none
}

body:json {
  {
    "amount": -5
  }
}

assert {
  res.status: eq 422
  res.body.code: eq INVALID_AMOUNT
  res.body.correlationId: isString
}
