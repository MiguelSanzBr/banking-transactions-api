meta {
  name: Deposit 0.1 + 0.2 as a float -> 400
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/accounts/{{accountA}}/deposits
  body: json
  auth: none
}

body:json {
  {
    "amount": 0.30000000000000004
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_ERROR
  res.body.correlationId: isString
}

docs {
  More than 2 decimal places is rejected, never rounded.
}
