# Read by docker compose (copy to .env to override). Every value has the same default in docker-compose.yml.
# Host port of the API; change it to run several stacks side by side.
API_PORT=3000
# Keep the password URL-safe: compose embeds it in DATABASE_URL.
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking
# API settings: same defaults as src/config.ts.
LOG_LEVEL=info
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TX_TIMEOUT_MS=30000
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
